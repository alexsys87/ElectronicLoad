<Application x:Class="Electronic_Load.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Electronic_Load"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette: replaced at run time by ThemeManager (must stay a separate dictionary) -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <!-- Theme-independent control styles -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <local:OxyColorToBrushConverter x:Key="OxyColorToBrushConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
