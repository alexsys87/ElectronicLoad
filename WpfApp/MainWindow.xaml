<Window x:Class="Electronic_Load.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Electronic_Load"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Electronic Load Tester Software (PX-100)" Height="720" Width="1100"
        MinHeight="560" MinWidth="820"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding ExportGraphCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding ImportGraphCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Big numeric readout tile -->
        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Menu + header bar ================= -->
        <StackPanel Grid.Row="0">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="_Open Graph (CSV)..." Command="{Binding ImportGraphCommand}" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="_Save Graph (CSV)..." Command="{Binding ExportGraphCommand}" InputGestureText="Ctrl+S"/>
                    <MenuItem Header="Export Graph as _PNG..." Command="{Binding ExportPngGraphCommand}"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Theme">
                        <!-- Not IsCheckable: the check mark follows IsDarkTheme only (no local toggling) -->
                        <MenuItem Header="_Light" Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                  IsChecked="{Binding IsDarkTheme, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
                        <MenuItem Header="_Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                  IsChecked="{Binding IsDarkTheme, Mode=OneWay}"/>
                    </MenuItem>
                    <MenuItem Header="Toggle theme" Command="{Binding ToggleThemeCommand}" InputGestureText="Ctrl+T"/>
                    <Separator/>
                    <!-- Checkable + TwoWay binding only; a Command here would toggle the value back -->
                    <MenuItem Header="_Auto Scale" IsCheckable="True" IsChecked="{Binding AutoScaleEnabled, Mode=TwoWay}"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="Scan COM ports" Command="{Binding ScanComPortsCommand}"/>
                    <MenuItem Header="Clear Graph" Command="{Binding ClearGraphCommand}"/>
                    <MenuItem Header="Graph Settings..." Command="{Binding SettingsCommand}"/>
                </MenuItem>
                <MenuItem Header="_Set">
                    <MenuItem Header="Coordinate range..." Command="{Binding SetCoordinateCommand}"/>
                    <MenuItem Header="Measurement name..." Command="{Binding SetMeasurementNameCommand}"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="About" Command="{Binding AboutCommand}"/>
                </MenuItem>
            </Menu>

            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="4,2">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}"
                            Content="{Binding ThemeToggleGlyph}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="Switch light / dark theme (Ctrl+T)"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}" Content="⚙" Command="{Binding SettingsCommand}" ToolTip="Graph settings"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="📁" Command="{Binding ImportGraphCommand}" ToolTip="Open graph (CSV)"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="💾" Command="{Binding ExportGraphCommand}" ToolTip="Save graph (CSV)"/>
                        <Border Width="1" Margin="6,3" Background="{DynamicResource ControlBorderBrush}"/>
                        <TextBlock Text="Electronic Load Tester Software" VerticalAlignment="Center" Margin="6,0" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ================= Main area ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Graph + table -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="170" MinHeight="80"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                    <oxy:PlotView Model="{Binding PlotModel}" Background="Transparent"/>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"/>

                <DataGrid x:Name="DataGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          ItemsSource="{Binding DataRecords}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="70"/>
                        <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedText}" Width="70"/>
                        <DataGridTextColumn Header="Volt(V)" Binding="{Binding Voltage, StringFormat=F3}" Width="70"/>
                        <DataGridTextColumn Header="Curr(A)" Binding="{Binding Current, StringFormat=F3}" Width="70"/>
                        <DataGridTextColumn Header="Power(W)" Binding="{Binding Power, StringFormat=F2}" Width="75"/>
                        <DataGridTextColumn Header="Temp(°C)" Binding="{Binding Temperature, StringFormat=F0}" Width="70"/>
                        <DataGridTextColumn Header="Cap(mAh)" Binding="{Binding Capacity, StringFormat=F0}" Width="75"/>
                        <DataGridTextColumn Header="En(mWh)" Binding="{Binding Energy, StringFormat=F0}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Control panel -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceTimeText}" FontFamily="Consolas, Segoe UI"
                                       Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"
                                       ToolTip="Device test time"/>
                            <TextBlock Text="{Binding LoadStateText}" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource LoadOffBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadOn}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource LoadOnBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>

                        <!-- Readouts -->
                        <UniformGrid Columns="2" Rows="3">
                            <Border Style="{StaticResource TileBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding Voltage, StringFormat=F3}" Foreground="{DynamicResource VoltageBrush}"/>
                                    <TextBlock Style="{StaticResource TileUnit}" Text="V"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding Current, StringFormat=F3}" Foreground="{DynamicResource CurrentBrush}"/>
                                    <TextBlock Style="{StaticResource TileUnit}" Text="A"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding Power, StringFormat=F2}" Foreground="{DynamicResource PowerBrush}"/>
                                    <TextBlock Style="{StaticResource TileUnit}" Text="W"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding Temperature, StringFormat=F0}" Foreground="{DynamicResource TemperatureBrush}"/>
                                    <TextBlock Style="{StaticResource TileUnit}" Text="°C"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding Capacity, StringFormat=F0}" Foreground="{DynamicResource CapacityBrush}"/>
                                    <TextBlock Style="{StaticResource TileUnit}" Text="mAh"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding Energy, StringFormat=F0}" Foreground="{DynamicResource EnergyBrush}"/>
                                    <TextBlock Style="{StaticResource TileUnit}" Text="mWh"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- PX-100 supports constant current with cutoff voltage and timer only -->
                        <GroupBox Header="Load settings (constant current)" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Content="Current:" Margin="0,0,8,4" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding SetCurrentText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="0.00 .. 255.99, 0.01 A resolution"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="A" Margin="6,0,0,4" VerticalAlignment="Center" Width="16"/>

                                <Label Grid.Row="1" Content="Cutoff voltage:" Margin="0,0,8,4" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding CutoffVoltageText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="The load switches off when the voltage drops below this value"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="V" Margin="6,0,0,4" VerticalAlignment="Center"/>

                                <Label Grid.Row="2" Content="Timer:" Margin="0,0,8,4" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Text="{Binding TimerText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="hh:mm:ss, 00:00:00 = timer off, max 18:12:15"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="h:m:s" Margin="6,0,0,4" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="10"/>

                                <Button Grid.Row="3" Grid.ColumnSpan="3" Content="Apply to device" Margin="0,4,0,4" Height="26"
                                        Command="{Binding ApplySettingsCommand}"/>

                                <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding DeviceSetpointsText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/>
                            </Grid>
                        </GroupBox>

                        <Button Content="{Binding StartStopButtonText}" Height="40" Margin="0,12,0,6" FontWeight="Bold"
                                Style="{StaticResource AccentButtonStyle}" Command="{Binding StartStopCommand}"
                                ToolTip="Start: send settings and switch the load on. Stop: switch the load off."/>
                        <Button Content="Clear Data" Height="28" Margin="0,0,0,4" Command="{Binding ClearDataCommand}"
                                ToolTip="Clear the log and reset the device mAh / mWh / time counters"/>

                        <TextBlock Text="{Binding LastEvent}" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/>

                        <GroupBox Header="Serial port (9600 8N1)">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="⟳" Width="28" Margin="6,0,0,0"
                                            Command="{Binding ScanComPortsCommand}" ToolTip="Rescan COM ports"/>
                                    <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"
                                              IsEnabled="{Binding CanEditPort}"/>
                                </DockPanel>
                                <Button Content="{Binding ConnectButtonText}" Height="26" Command="{Binding ConnectCommand}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= Status bar ================= -->
        <StatusBar Grid.Row="2" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectionStatus}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding BaudRate, StringFormat='Baud: {0}'}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding MeasurementName}" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Margin="0,0,6,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
