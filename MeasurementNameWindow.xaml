<Window x:Class="Electronic_Load.MeasurementNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Measurement name" SizeToContent="Height" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Enter measurement name:" Margin="0,0,0,5"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1" Height="26" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Height="26" Margin="5" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="75" Height="26" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
