<Window x:Class="Electronic_Load.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graph Settings" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- BasedOn keeps the themed ComboBox template -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="12" Margin="0,0,8,0" CornerRadius="2"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                    Background="{Binding Color, Converter={StaticResource OxyColorToBrushConverter}}"/>
                            <TextBlock Text="{Binding Name}" Margin="0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Voltage color:" Grid.Row="0"/>
        <ComboBox x:Name="VoltageColorCombo" Grid.Row="0" Grid.Column="1"/>

        <TextBlock Text="Current color:" Grid.Row="1"/>
        <ComboBox x:Name="CurrentColorCombo" Grid.Row="1" Grid.Column="1"/>

        <TextBlock Text="Temperature color:" Grid.Row="2"/>
        <ComboBox x:Name="TemperatureColorCombo" Grid.Row="2" Grid.Column="1"/>

        <TextBlock Text="Power color:" Grid.Row="3"/>
        <ComboBox x:Name="PowerColorCombo" Grid.Row="3" Grid.Column="1"/>

        <TextBlock Text="Legend background:" Grid.Row="4"/>
        <ComboBox x:Name="LegendBackgroundCombo" Grid.Row="4" Grid.Column="1"/>

        <TextBlock Text="Legend border:" Grid.Row="5"/>
        <ComboBox x:Name="LegendBorderCombo" Grid.Row="5" Grid.Column="1"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource SubtleTextBrush}"
                   Text="&quot;Auto (theme)&quot; picks a color that is readable in the current light or dark theme."/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="OK" Width="80" Height="30" Margin="5" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Height="30" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
